{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AUTH_*",
    "BASE_URL",
    "CHIEF_*",
    "CLOUDFLARE_*",
    "CODEX_PATH",
    "CONVEX_SITE_URL",
    "EXECUTOR_*",
    "GOOGLE_*",
    "LOCALAPPDATA",
    "AI_GATEWAY_API_KEY",
    "MARKETER_*",
    "OPENCODE_PATH",
    "STRIPE_*",
    "TAURI_*",
    "VITE_*",
    "WORKSPACE_MODEL"
  ],
  "globalPassThroughEnv": [
    "APPLE_SIGNING_IDENTITY",
    "CI",
    "NODE_ENV",
    "npm_lifecycle_event"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".cache/tsbuildinfo.json",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".output/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "outputs": [".cache/.prettiercache"]
    },
    "lint": {
      "dependsOn": ["topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "test": {
      "dependsOn": ["topo", "^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
