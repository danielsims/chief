{
  "name": "@chief/agent-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./agents": "./src/agents.ts",
    "./capabilities": "./src/capabilities/index.ts"
  },
  "scripts": {
    "build:desktop-sidecar": "node scripts/build-desktop-sidecar.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.5",
    "@libsql/client": "0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.144.1",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.19.0",
    "ai": "7.0.19",
    "cron-parser": "5.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "executor": "1.5.30",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chief/eslint-config": "workspace:*",
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.27.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tar": "^7.5.20",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
