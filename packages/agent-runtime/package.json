{
  "name": "@chief/agent-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./artifact-types": "./src/artifact-types.ts",
    "./agents": "./src/agents.ts",
    "./agent-roster": "./src/agent-roster.ts",
    "./agent-tool-permissions": "./src/agent-tool-permissions.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./integration-setup-recipes": "./src/integration-setup-recipes.ts",
    "./integration-requests": "./src/integration-requests.ts"
  },
  "scripts": {
    "build:desktop-sidecar": "node scripts/build-desktop-sidecar.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "smoke:convex": "tsx scripts/smoke-convex-deployment.mts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.5",
    "@chief/browser": "workspace:*",
    "@chief/channel-api": "workspace:*",
    "@chief/email": "workspace:*",
    "@chief/google-oauth-connector": "workspace:*",
    "@libsql/client": "0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.144.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.19.0",
    "@vercel/connect": "^0.3.2",
    "ai": "7.0.30",
    "convex": "^1.42.1",
    "cron-parser": "5.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "eve": "0.24.6",
    "executor": "1.5.37",
    "microsandbox": "0.6.6",
    "pnpm": "10.17.1",
    "react": "^19.1.0",
    "vercel": "56.3.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chief/eslint-config": "workspace:*",
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.27.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tar": "^7.5.20",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
