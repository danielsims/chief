{
  "name": "@chief/agent-runtime",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./cells": "./src/cells/types.ts",
    "./cells/cloudflare": "./src/cells/cloudflare.ts",
    "./cells/memory": "./src/cells/memory-persistence.ts",
    "./durable-turn": "./src/durable-turn/index.ts",
    "./artifact-types": "./src/artifact-types.ts",
    "./agents": "./src/agents.ts",
    "./agent-roster": "./src/agent-roster.ts",
    "./agent-definitions": "./src/agent-definitions.ts",
    "./agent-tool-permissions": "./src/agent-tool-permissions.ts",
    "./channel-message-mentions": "./src/channel-message-mentions.ts",
    "./prompts": "./src/prompts/index.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./integration-setup-recipes": "./src/integration-setup-recipes.ts",
    "./integration-requests": "./src/integration-requests.ts",
    "./git-objects": "./src/git-objects.ts",
    "./vercel-eve-provisioning": "./src/vercel-eve-provisioning.ts",
    "./local-tools": "./src/tools/model.ts",
    "./onboarding-message-pacing": "./src/onboarding-message-pacing.ts",
    "./recurring-work": "./src/recurring-work.ts"
  },
  "scripts": {
    "build:desktop-sidecar": "node scripts/build-desktop-sidecar.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsx watch src/server.ts",
    "generate:local-tools-openapi": "tsx scripts/generate-local-tools-openapi.mts",
    "generate:agent-instructions": "tsx scripts/generate-agent-instructions.mts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "pnpm --dir ../.. exec oxlint packages/agent-runtime",
    "smoke:agent-live": "CHIEF_LIVE_MODEL=opencode-go/deepseek-v4-flash tsx scripts/smoke-live-channel-agent.mts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:pressure": "CHIEF_PRESSURE_ITERATIONS=100 node --import tsx --test --test-concurrency=1 test/channel-agent-pressure.test.ts test/channel-response-fallback.test.ts test/session-recovery.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@anthropic-ai/claude-agent-sdk": "^0.1.5",
    "@chief/agent-computer": "workspace:*",
    "@chief/browser": "workspace:*",
    "@chief/channel-api": "workspace:*",
    "@chief/email": "workspace:*",
    "@chief/google-oauth-connector": "workspace:*",
    "@chief/plugin-api": "workspace:*",
    "@chief/relay-client": "workspace:*",
    "@chief/relay-contracts": "workspace:*",
    "@libsql/client": "0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.148.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.19.0",
    "ai": "7.0.30",
    "cron-parser": "5.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "eve": "0.24.6",
    "executor": "1.5.37",
    "microsandbox": "0.6.6",
    "pnpm": "10.17.1",
    "react": "^19.1.0",
    "tar": "^7.5.20",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.27.0",
    "prettier": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
