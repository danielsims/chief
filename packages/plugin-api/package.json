{
  "name": "@chief/plugin-api",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reference": "./src/reference.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "pnpm --dir ../.. exec oxlint packages/plugin-api",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
