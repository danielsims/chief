{
  "name": "@chief/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./convex/*": "./convex/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "convex dev",
    "deploy": "convex deploy",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "pnpm --dir ../.. exec oxlint packages/backend",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.3",
    "@t3-oss/env-core": "^0.13.8",
    "better-auth": "1.6.16",
    "convex": "^1.31.6",
    "stripe": "^22.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
