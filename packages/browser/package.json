{
  "name": "@chief/browser",
  "version": "0.1.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "pnpm --dir ../.. exec oxlint packages/browser",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agent-browser": "0.32.3"
  },
  "devDependencies": {
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
