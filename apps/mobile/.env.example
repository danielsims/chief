# Local signing configuration for the iOS app. Copy to .env and fill in.
# This file is committed as a template; .env is gitignored.
#
# Find your team ID at https://developer.apple.com/account → Membership,
# or in Xcode under Signing & Capabilities after selecting your team.

# Apple Developer team identifier. Required for device builds.
CHIEF_APPLE_TEAM_ID=

# Bundle identifier prefix used by the app, widget and test targets.
CHIEF_BUNDLE_ID=
