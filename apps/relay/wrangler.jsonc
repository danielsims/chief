{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chief-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "WorkspaceObject" },
      { "name": "ACCOUNTS", "class_name": "AccountObject" },
      { "name": "CONVERSATIONS", "class_name": "ConversationObject" },
      { "name": "AGENTS", "class_name": "AgentObject" },
      { "name": "METRICS", "class_name": "AnalyticsObject" },
      { "name": "IDENTITIES", "class_name": "IdentityObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceObject",
        "ConversationObject",
        "AgentObject",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountObject"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AnalyticsObject"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["IdentityObject"],
    },
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "chief-relay-artifacts" },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "chief-relay-auth",
      "database_id": "86b1e10c-f1b2-4772-bc3a-c7b07d7e751b",
      "migrations_dir": "../../packages/auth/migrations",
    },
  ],
  "vars": {
    "RELAY_DEPLOYMENT": "chief-cloud",
    "ACCOUNT_IDENTITY_MODE": "chief-account",
    "AUTH_BASE_URL": "https://chief-relay.danielsims-browser-ui.workers.dev",
    "AUTH_UI_ORIGIN": "https://heychief.sh",
    "AUTH_GOOGLE_REDIRECT_URI": "https://heychief.sh/api/auth/callback/google",
  },
  "observability": { "enabled": true },
}
