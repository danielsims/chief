{
  "name": "@chief/workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:node": "node scripts/assert-node-version.mjs .nvmrc",
    "generate": "tsx scripts/generate.ts",
    "dev": "eve dev",
    "build": "eve build",
    "build:source": "pnpm generate && eve build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "pnpm --dir ../.. exec oxlint apps/workspace",
    "start": "eve start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/connect": "^0.3.2",
    "ai": "7.0.30",
    "eve": "0.24.6",
    "microsandbox": "0.6.6",
    "vercel": "56.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
