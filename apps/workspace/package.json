{
  "name": "@chief/workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "eve dev",
    "build": "eve build",
    "build:source": "pnpm generate && eve build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "eve start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/connect": "^0.3.2",
    "ai": "7.0.19",
    "eve": "0.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.38.0",
    "microsandbox": "^0.6.6",
    "prettier": "^3.6.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
