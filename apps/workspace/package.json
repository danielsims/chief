{
  "name": "@chief/workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "eve dev",
    "build": "eve build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "eve start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/connect": "^0.3.2",
    "eve": "^0.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chief/agent-runtime": "workspace:*",
    "@chief/eslint-config": "workspace:*",
    "@chief/prettier-config": "workspace:*",
    "@chief/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "microsandbox": "^0.6.6",
    "prettier": "catalog:",
    "tsx": "^4.23.0",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config"
}
