# Development configuration. Never commit real credentials.
CHIEF_RELAY_URL=https://your-relay.example.com
# The relay origin a browser connects to. Defaults to CHIEF_RELAY_URL. Set this
# when the web UI and relay are served from different origins (for example the
# hosted heychief.sh UI fronting relay.heychief.sh).
CHIEF_PUBLIC_RELAY_URL=https://your-relay.example.com

# Optional: permits update checks while the GitHub repository is private and
# increases the GitHub API rate limit. Use a fine-grained, read-only token.
GITHUB_TOKEN=replace-with-a-read-only-token
