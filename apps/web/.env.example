# Development configuration. Never commit real credentials.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional: permits update checks while the GitHub repository is private and
# increases the GitHub API rate limit. Use a fine-grained, read-only token.
GITHUB_TOKEN=replace-with-a-read-only-token
