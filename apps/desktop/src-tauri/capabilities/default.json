{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-badge-label",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-open-path",
    "dialog:allow-open",
    "deep-link:default",
    "deep-link:allow-get-current",
    "deep-link:allow-is-registered",
    "deep-link:allow-register",
    "os:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/**" },
        { "url": "http://localhost:1420/**" },
        { "url": "https://heychief.sh/**" },
        { "url": "https://accounts.google.com/**" },
        { "url": "https://*.googleusercontent.com/**" },
        { "url": "https://oauth2.googleapis.com/**" },
        { "url": "https://integrations.sh/**" },
        { "url": "https://chief-relay.danielsims-browser-ui.workers.dev/**" },
        { "url": "https://*.convex.cloud/**" },
        { "url": "https://*.convex.site/**" }
      ]
    }
  ]
}
