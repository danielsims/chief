{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chief",
  "version": "0.1.0",
  "identifier": "com.danielsims.chief",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm runtime:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Chief",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0c0c0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["chief-desktop"]
      }
    },
    "updater": {
      "endpoints": [
        "https://heychief.sh/api/update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MTZEMzI1REVEMzFDQjUKUldTMUhOUGVKZE1XSmFzeisxL0ZVQ1gxSmtFVXlkN3RQcG12MXlBT0llcitBOGpUWE9xdHl4ckgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/chief-agent-runtime"],
    "resources": {
      "resources/agent-runtime.tar.gz": "agent-runtime.tar.gz",
      "resources/agent-runtime.version": "agent-runtime.version"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
