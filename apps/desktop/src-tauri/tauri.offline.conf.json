{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && pnpm runtime:bundle && node scripts/package-plugin-runtime.mjs --clear"
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/chief-agent-runtime"],
    "resources": {
      "resources/agent-runtime": "agent-runtime",
      "resources/agent-runtime.version": "agent-runtime.version"
    }
  }
}
