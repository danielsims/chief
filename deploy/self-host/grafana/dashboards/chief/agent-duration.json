          },
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"chief-relay\" && resource.chief.relay.id =~ \"${relay:raw}\" && span.gen_ai.operation.name = \"invoke_agent\" && span.chief.workspace.id =~ \"${workspace:raw}\" && span.gen_ai.agent.name =~ \"${agent:regex}\" } | sum_over_time(span:duration) by (resource.chief.relay.id, span.chief.workspace.name)",
          "queryType": "traceql",
          "refId": "A",
          "serviceMapUseNativeHistograms": false,
