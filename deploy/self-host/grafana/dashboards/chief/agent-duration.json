  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to use this dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "# Chief agent duration\nTrack p95 and total traced agent execution time by relay and workspace. Use minute, hour, and day windows to isolate spikes before comparing changes."
      }
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"chief-relay\" && resource.chief.relay.id =~ \"${relay:raw}\" && span.gen_ai.operation.name = \"invoke_agent\" && span.chief.workspace.id =~ \"${workspace:raw}\" && span.gen_ai.agent.name =~ \"${agent:regex}\" } | quantile_over_time(span:duration, .95) by (resource.chief.relay.id, span.chief.workspace.name)",
          "queryType": "traceql",
          "refId": "A",
          "serviceMapUseNativeHistograms": false
        }
      ],
      "title": "p95 agent duration by workspace",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
