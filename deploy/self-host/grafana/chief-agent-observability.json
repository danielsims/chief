            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only this channel / conversation",
                    "url": "/d/chief-agent-observability/chief-agent-observability?var-relay=${relay:raw}&var-workspace=.*&var-agent=.*&var-conversation=${__value.raw}"
                  }
                ]
              }
            ]
