  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "# Chief agent observability\nFilter by relay, workspace, workflow, agent, or channel. Execution-time charts use traced agent duration for local iteration; Cloudflare Durable Object analytics remains the source of truth for production billing. Select a trace ID to open Tempo's complete waterfall.",
        "mode": "markdown"
      },
      "title": "How to use this dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "chief.workflow.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only this workflow",
                    "url": "/d/chief-agent-observability/chief-agent-observability?var-relay=${relay:raw}&var-workspace=${workspace:raw}&var-workflow=${__value.raw}&var-agent=${agent:regex}&var-conversation=${conversation:raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 250,
          "metricsQueryType": "range",
          "query": "{ resource.service.name = \"relay\" && resource.chief.relay.id =~ \"${relay:raw}\" && span.chief.workflow.id =~ \"${workflow:raw}\" && span.chief.workspace.id =~ \"${workspace:raw}\" } | select(span.chief.workflow.id, span.chief.workspace.name, span.chief.workspace.id, span.chief.lifecycle.layer, span.chief.lifecycle.stage, span.gen_ai.agent.name, span.gen_ai.conversation.id, span.chief.job.id, span.gen_ai.operation.name, span.gen_ai.tool.name, span.messaging.message.id)",
          "queryType": "traceql",
          "refId": "A",
          "serviceMapUseNativeHistograms": false,
          "tableType": "spans"
        }
      ],
      "title": "End-to-end workflow timeline",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.agent.name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only this agent",
                    "url": "/d/chief-agent-observability/chief-agent-observability?var-relay=${relay:raw}&var-workspace=.*&var-agent=${__value.raw}&var-conversation=.*"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gen_ai.conversation.id"
