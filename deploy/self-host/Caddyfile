{
	admin off
	auto_https disable_redirects
}

:2019 {
	respond /healthz 200
}

{$CHIEF_SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	header {
		-Server
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# The dev loop mounts only its current CLI here. Without that mount this
	# matcher does not match, so normal self-host installs use the relay.
	@development_files {
		path /install/machine /dev/chief-machine
		file {
			root /srv/chief-dev
			try_files {path}
		}
	}
	handle @development_files {
		root * /srv/chief-dev
		file_server
	}

	@relay {
		path /api/auth /api/auth/* /.well-known/* /git/* /github/* /mcp /mcp/* /health /openapi.json /v1/* /connect /install/*
	}
	handle @relay {
		reverse_proxy relay:8787
	}

	handle {
		reverse_proxy web:3000
	}
}
