# The browser/native-client origin. Include the non-standard port in local use.
CHIEF_PUBLIC_URL=http://localhost:8080

# Caddy site address. Use a real hostname without a scheme for automatic TLS.
CHIEF_SITE_ADDRESS=http://localhost
CHIEF_HTTP_PORT=8080
CHIEF_HTTPS_PORT=8443

# Create a distinct OAuth client for this relay and register:
# ${CHIEF_PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=

# Optional transactional invitation email delivery through Cloudflare Email
# Service. Local development logs the invitation URL when these are omitted.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=invites@example.com
EMAIL_FROM_NAME=Chief

CHIEF_LOG_LEVEL=info
CHIEF_RELAY_IMAGE=chief-relay:local
CHIEF_WEB_IMAGE=chief-web:local

# Identifies this environment inside its own telemetry store. Keep local
# development distinct from any independently hosted relay.
RELAY_DEPLOYMENT=local-development

# The computer is independently deployable from the relay. For a Cloudflare
# relay, set this to the HTTPS tunnel URL that forwards to the computer port.
CHIEF_COMPUTER_PUBLIC_URL=http://localhost:8788
CHIEF_COMPUTER_PORT=8788
CHIEF_COMPUTER_IMAGE=chief-computer:local
