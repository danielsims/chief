{
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "destinations": ["chief-production-grafana-logs"],
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "destinations": ["chief-production-grafana-traces"],
    },
  },
}
