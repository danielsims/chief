{
  "name": "chief",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:fix",
    "check:node": "node apps/workspace/scripts/assert-node-version.mjs .nvmrc",
    "check:staged": "lint-staged --concurrent false && pnpm lint:source-size && pnpm typecheck",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "desktop": "turbo dev --filter=@chief/desktop",
    "desktop:dmg": "APPLE_SIGNING_IDENTITY='Developer ID Application: Latent Supply Pty Ltd (XMMXB25823)' pnpm --filter @chief/desktop build:app && codesign --verify --deep --strict --verbose=2 apps/desktop/src-tauri/target/release/bundle/macos/Chief.app && open -R apps/desktop/src-tauri/target/release/bundle/dmg/Chief_*.dmg",
    "email": "pnpm --filter=@chief/email dev",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "pnpm lint:source-size && turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:source-size": "node tooling/scripts/check-source-file-length.mjs",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "prepare": "husky",
    "test": "turbo run test",
    "test:agent-pressure": "pnpm --filter @chief/agent-runtime test:pressure",
    "test:agent-live": "pnpm --filter @chief/agent-runtime smoke:agent-live",
    "typecheck": "turbo run typecheck",
    "desktop:dev": "bash scripts/dev-desktop.sh"
  },
  "devDependencies": {
    "@chief/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "catalog:",
    "turbo": "^2.5.5",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  }
}
