{
  "name": "chief",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "desktop": "turbo dev --filter=@chief/desktop",
    "email": "pnpm --filter=@chief/email dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "better-auth>zod": "4.3.6"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
