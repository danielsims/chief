{
  "name": "chief",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:fix",
    "check:staged": "lint-staged --concurrent false --hide-all --diff-filter=ACMRD",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "desktop": "turbo dev --filter=@chief/desktop",
    "desktop:dmg": "APPLE_SIGNING_IDENTITY='Developer ID Application: Latent Supply Pty Ltd (XMMXB25823)' pnpm --filter @chief/desktop build:app:offline && codesign --verify --deep --strict --verbose=2 apps/desktop/src-tauri/target/release/bundle/macos/Chief.app && pnpm --filter @chief/desktop verify:packaged-plugin-host && open -R apps/desktop/src-tauri/target/release/bundle/dmg/Chief_*.dmg",
    "email": "pnpm --filter=@chief/email dev",
    "executor:build": "pnpm --filter=@chief/executor build",
    "executor:image": "docker build --file apps/executor/Dockerfile --tag chief-executor:dev .",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --force --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "pnpm oxlint . && pnpm lint:source-size",
    "lint:source-size": "node tooling/scripts/check-source-file-length.mjs",
    "lint:fix": "oxlint . --fix",
    "mobile:build": "pnpm mobile:generate && xcodebuild -project apps/mobile/ChiefMobile.xcodeproj -scheme Chief -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build CODE_SIGNING_ALLOWED=NO",
    "mobile:generate": "cd apps/mobile && xcodegen generate",
    "mobile:test": "bash apps/mobile/scripts/test.sh",
    "mobile:verify-icon": "bash apps/mobile/scripts/verify-icon.sh",
    "prepare": "husky",
    "relay:deploy": "pnpm --filter=@chief/relay run deploy",
    "relay:dev": "pnpm --filter=@chief/relay dev",
    "self-host:config": "docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml config",
    "self-host:down": "docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml down --remove-orphans",
    "self-host:init": "sh deploy/self-host/scripts/init.sh",
    "self-host:logs": "docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml logs --follow --tail 200",
    "self-host:up": "docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml up --detach --build --remove-orphans",
    "self-host:up:observability": "RELAY_TELEMETRY_MODE=full RELAY_OTLP_ENDPOINT=http://observability:4318 docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml --profile observability up --detach --build --remove-orphans",
    "self-host:up:tunnel": "docker compose --env-file deploy/self-host/.env --file deploy/self-host/compose.yaml --profile tunnel up --detach --build --remove-orphans",
    "test": "turbo run test",
    "test:commit-hook": "node --test tooling/scripts/format-staged.test.mjs",
    "test:agent-pressure": "pnpm --filter @chief/agent-runtime test:pressure",
    "test:agent-live": "pnpm --filter @chief/agent-runtime smoke:agent-live",
    "typecheck": "turbo run typecheck",
    "desktop:dev": "bash scripts/dev-desktop.sh"
  },
  "devDependencies": {
    "@chief/oxlint-config": "workspace:*",
    "@chief/prettier-config": "workspace:*",
    "effect": "4.0.0-beta.107",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.5.5",
    "typescript": "catalog:"
  },
  "prettier": "@chief/prettier-config",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  }
}
